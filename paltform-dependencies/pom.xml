    <artifactId>platform-dependencies</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>



    <properties>
        <spring-cloud.version>Hoxton.SR1</spring-cloud.version>
        <alibaba.cloud.version>2.2.0.RELEASE</alibaba.cloud.version>
        <spring-boot.version>2.2.5.RELEASE</spring-boot.version>

        <tk-mybatis.version>2.1.5</tk-mybatis.version>
        <pagehelper.version>1.2.10</pagehelper.version>
        <oracle.version>12.2.0.3</oracle.version>
        <mysql.version>8.0.20</mysql.version>
        <hutool.version>5.2.3</hutool.version>
        <mapstruct.version>1.3.1.Final</mapstruct.version>
        <jwt.version>3.4.1</jwt.version>

        <!--        <swagger.version>2.9.2</swagger.version>-->
        <knife4j.version>2.0.2</knife4j.version>
        <springfox.version>2.9.2</springfox.version>
        <swagger.version>1.5.21</swagger.version>
        <orai18n.version>12.1.0.2.0</orai18n.version>
        <easyexcel.version>2.1.6</easyexcel.version>

        <!--<erishiyi.version>1.0.0</erishiyi.version>-->
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- Swagger API文档 -->
