<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bowden.mapper.CommonDictionaryMapper">
    <resultMap id="BaseResultMap" type="com.bowden.domain.CommonDictionary">
        <!--@mbg.generated-->
        <!--@Table COMMON_DICTIONARY-->
        <id column="GUID" jdbcType="VARCHAR" property="guid"/>
        <result column="TYPEID" jdbcType="VARCHAR" property="typeid"/>
        <result column="CODEID" jdbcType="VARCHAR" property="codeid"/>
        <result column="CODENAME" jdbcType="VARCHAR" property="codename"/>
        <result column="PYNAME" jdbcType="VARCHAR" property="pyname"/>
        <result column="IFUSE" jdbcType="DECIMAL" property="ifuse"/>
        <result column="SORT" jdbcType="DECIMAL" property="sort"/>
        <result column="DELETED" jdbcType="DECIMAL" property="deleted"/>
        <result column="CREATEDT" jdbcType="TIMESTAMP" property="createDate"/>
        <result column="CREATORID" jdbcType="VARCHAR" property="creatorId"/>
        <result column="CREATOR" jdbcType="VARCHAR" property="creator"/>
        <result column="MODIFYDT" jdbcType="TIMESTAMP" property="modifyDate"/>
        <result column="MODIFIERID" jdbcType="VARCHAR" property="modifierid"/>
        <result column="MODIFIER" jdbcType="VARCHAR" property="modifier"/>
        <result column="TIMESTAMP" jdbcType="DECIMAL" property="timestamp"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        GUID, TYPEID, CODEID, CODENAME, PYNAME, IFUSE, SORT, DELETED, CREATEDT, CREATORID,
        CREATOR, MODIFYDT, MODIFIERID, MODIFIER, "TIMESTAMP"
    </sql>

    <select id="getDictByTypeId" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from COMMON_DICTIONARY where DELETED =0 and IFUSE =1 and TYPEID =#{typeId}
        order by SORT ,CODEID
    </select>

</mapper>